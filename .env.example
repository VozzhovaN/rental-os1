DATABASE_URL="file:./dev.db"

# CRM auth (Stage 11.1–11.3)
# SESSION_SECRET: min 32 chars in production; peppers session token hashes.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Canonical origin for CSRF (scheme + host). Required in production.
# Example: https://crm.example.com
APP_ORIGIN=
# Integration token encryption (AES-256-GCM). Min 32 chars in production.
INTEGRATION_ENCRYPTION_KEY=
# Optional: session lifetime in days (default 7)
# SESSION_TTL_DAYS=7

# CIAN long-term publication (optional; status sync / unpublish still blocked without live contract)
CIAN_ACCESS_KEY=
CIAN_FEED_BASE_URL=
CIAN_ACCOUNT_ID=

# --- Course Demo (Stage 14) ---
# Presentation/safety flag only. Enables the "Rental OS · DEMO" banner and the
# demo reset guard. MUST NOT be used to bypass auth/CSRF/validation/FSM/finance.
# DEMO_MODE=true
# Persistent root for uploaded photo bytes. Defaults to <cwd>/storage.
# In a demo/deployment, point this at a persistent volume.
# PHOTO_STORAGE_ROOT=/data/storage
# For a demo DB use a file whose name contains "demo" so demo:reset is allowed,
# e.g. DATABASE_URL="file:./demo.db"
