generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ManagementType {
  OWN
  COMMISSION
}

enum RentCollectionMode {
  OPERATOR
  OWNER_DIRECT
}

model Property {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  type               PropertyType
  status             PropertyStatus   @default(ACTIVE)
  address            String
  city               String
  district           String
  area               Float
  rooms              Int
  bedrooms           Int
  bathrooms          Int
  floor              Int?
  totalFloors        Int?
  guests             Int
  description        String
  shortDescription   String
  /// Legacy free-text owner label. Prefer ownerId for COMMISSION settlements.
  ownerName          String
  ownerPhone         String
  /// Structured owner for COMMISSION properties. Null for OWN (no external owner debt).
  ownerId            String?
  managementType     ManagementType
  /// Who collects rent from guests/tenants. OWN must use OPERATOR.
  rentCollectionMode RentCollectionMode   @default(OPERATOR)
  dailyPrice         Int?
  /// Ориентир экономики объекта. Не источник истины для долгосрочной аренды
  /// (см. LongTermListing.monthlyPrice). Поля не синхронизируются.
  monthlyPrice       Int?
  /// Комиссия в процентах, например 15 = 15%
  commissionDaily    Float?
  /// Комиссия в процентах, например 20 = 20%
  commissionMonthly  Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  channelListings    ChannelListing[]
  bookings           Booking[]
  photos             PropertyPhoto[]
  longTermListing    LongTermListing?
  saleListing        SaleListing?
  financialTransactions FinancialTransaction[]
  longTermContracts  LongTermContract[]
  owner              Owner?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  payoutAllocations  OwnerPayoutAllocation[]
  commissionPayments CommissionPayment[]

  @@index([status])
  @@index([city])
  @@index([type])
  @@index([managementType])
  @@index([ownerId])
}

enum ChannelListingStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ChannelSyncStatus {
  NOT_CONNECTED
  CONNECTED
  SYNCED
  ERROR
}

model SalesChannel {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  listings           ChannelListing[]
  bookings           Booking[]
  connections        IntegrationConnection[]
  externalBookings   ExternalBooking[]
  publications       Publication[]
  salePublications   SalePublication[]
}

model ChannelListing {
  id             String                @id @default(cuid())
  propertyId     String
  salesChannelId String
  externalId     String
  externalUrl    String?
  status         ChannelListingStatus  @default(ACTIVE)
  syncStatus     ChannelSyncStatus     @default(CONNECTED)
  lastSyncAt     DateTime?
  syncError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  property       Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  salesChannel   SalesChannel          @relation(fields: [salesChannelId], references: [id])
  bookings       Booking[]

  @@unique([propertyId, salesChannelId])
  @@unique([salesChannelId, externalId])
  @@index([propertyId])
  @@index([salesChannelId])
}

enum MessengerType {
  MAX
  TELEGRAM
}

enum GuestHistoryType {
  CONTACT
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_CANCELLED
  CHECK_IN
  CHECK_OUT
  MESSAGE
  NOTE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Guest {
  id                String         @id @default(cuid())
  firstName         String
  lastName          String?
  middleName        String?
  phone             String?
  email             String?
  messengerType     MessengerType?
  messengerContact  String?
  comment           String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  bookings          Booking[]
  history           GuestHistory[]
  longTermContracts LongTermContract[]
}

model GuestHistory {
  id          String           @id @default(cuid())
  guestId     String
  type        GuestHistoryType
  title       String
  description String?
  createdAt   DateTime         @default(now())
  guest       Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, createdAt])
}

model Booking {
  id               String          @id @default(cuid())
  propertyId       String
  guestId          String
  salesChannelId   String
  channelListingId String?
  checkIn          DateTime
  checkOut         DateTime
  guestsCount      Int
  /// Gross guest stay price (integer RUB). Source of truth — not recalculated from dailyPrice.
  totalAmount      Int
  /// Locked commission rate in basis points (10000 = 100%). Set at first finance lock; immutable after.
  commissionRateBps Int?
  status           BookingStatus   @default(PENDING)
  comment          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  property         Property        @relation(fields: [propertyId], references: [id])
  guest            Guest           @relation(fields: [guestId], references: [id])
  salesChannel     SalesChannel    @relation(fields: [salesChannelId], references: [id])
  channelListing   ChannelListing? @relation(fields: [channelListingId], references: [id], onDelete: SetNull)
  externalBookings ExternalBooking[]
  financialTransactions FinancialTransaction[]
  payments         BookingPayment[]
  commissionPayments CommissionPayment[]

  @@index([propertyId])
  @@index([guestId])
  @@index([salesChannelId])
  @@index([status])
  @@index([checkIn, checkOut])
}

/// Fact of money received from guest for a short-term booking. Not an allocation.
model BookingPayment {
  id        String                 @id @default(cuid())
  bookingId String
  /// Always > 0. Integer RUB major units.
  amount    Int
  paidAt    DateTime
  method    String?
  note      String?
  createdAt DateTime               @default(now())
  booking   Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds   BookingPaymentRefund[]

  @@index([bookingId, paidAt])
}

/// Guest refund against a specific BookingPayment. Does not delete the original payment.
model BookingPaymentRefund {
  id        String         @id @default(cuid())
  paymentId String
  /// Always > 0. Integer RUB. Cumulative refunds per payment cannot exceed payment.amount.
  amount    Int
  refundedAt DateTime
  note      String?
  createdAt DateTime       @default(now())
  payment   BookingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, refundedAt])
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  SYNCING
  ERROR
}

enum SyncDirection {
  IMPORT
  EXPORT
}

enum SyncEntityType {
  LISTING
  BOOKING
  AVAILABILITY
  PRICE
}

enum SyncLogStatus {
  STARTED
  SUCCESS
  ERROR
  SKIPPED
}

model IntegrationConnection {
  id                String             @id @default(cuid())
  salesChannelId    String             @unique
  salesChannel      SalesChannel       @relation(fields: [salesChannelId], references: [id])
  providerAccountId String?
  status            IntegrationStatus  @default(DISCONNECTED)
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  lastSyncAt        DateTime?
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  logs              IntegrationSyncLog[]
}

model IntegrationSyncLog {
  id           String                 @id @default(cuid())
  connectionId String
  connection   IntegrationConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  direction    SyncDirection
  entityType   SyncEntityType
  status       SyncLogStatus
  externalId   String?
  startedAt    DateTime
  finishedAt   DateTime?
  errorCode    String?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime               @default(now())

  @@index([connectionId, createdAt])
  @@index([status])
  @@index([entityType])
}

model ExternalBooking {
  id             String       @id @default(cuid())
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  salesChannelId String
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id])
  externalId     String
  externalStatus String?
  rawData        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([salesChannelId, externalId])
  @@index([salesChannelId])
}

enum LongTermListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Общий пул фотографий объекта. LongTermListingPhoto / SaleListingPhoto только ссылаются сюда.
model PropertyPhoto {
  id               String                 @id @default(cuid())
  propertyId       String
  /// CRM / local preview URL (legacy external URL или /api/.../file). Не считается public HTTPS для CIAN.
  url              String
  /// Relative key inside PhotoStorage (null for legacy URL-only rows).
  storageKey       String?
  originalFileName String?
  mimeType         String?
  sizeBytes        Int?
  width            Int?
  height           Int?
  caption          String?
  sortOrder        Int                    @default(0)
  isCover          Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  property         Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  longTermUsages   LongTermListingPhoto[]
  saleUsages       SaleListingPhoto[]

  @@index([propertyId, sortOrder])
  @@index([propertyId, isCover])
}

model LongTermListing {
  id                          String                 @id @default(cuid())
  propertyId                  String                 @unique
  status                      LongTermListingStatus  @default(DRAFT)
  /// Источник истины для цены долгосрочной аренды. Не синхронизируется с Property.monthlyPrice.
  monthlyPrice                Int                    @default(0)
  specialOfferPrice           Int?
  specialOfferText            String?
  /// Обеспечительный депозит/залог арендатора, рубли. Не комиссия площадки.
  deposit                     Int                    @default(0)
  /// Внутренний процент комиссии карточки. Не ClientFee/AgentFee площадки (MAPPING_BLOCKED).
  commission                  Float                  @default(0)
  /// Минимальный срок аренды в месяцах. Поле не переименовывалось: семантика уже однозначна.
  minimumRentalPeriod         Int                    @default(1)
  marketingTitle              String                 @default("")
  description                 String                 @default("")
  rentalTerms                 String                 @default("")
  infrastructureDescription   String                 @default("")
  securityDescription         String                 @default("")
  parkingDescription          String                 @default("")
  transportDescription        String                 @default("")
  advantagesDescription       String                 @default("")
  /// Контакт для внешней публикации. Не Guest, не owner, не покупатель.
  publicationContactName      String?
  /// Телефонный код страны цифрами, без +. Например 7.
  publicationPhoneCountryCode String?
  /// Национальный номер цифрами, без форматирования площадки.
  publicationPhoneNumber      String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  property                    Property               @relation(fields: [propertyId], references: [id])
  photos                      LongTermListingPhoto[]
  publications                Publication[]
  financialTransactions       FinancialTransaction[]
  contracts                   LongTermContract[]

  @@index([status])
}

model LongTermListingPhoto {
  id        String          @id @default(cuid())
  listingId String
  photoId   String
  sortOrder Int             @default(0)
  included  Boolean         @default(true)
  listing   LongTermListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  photo     PropertyPhoto   @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([listingId, photoId])
  @@index([listingId, sortOrder])
}

/// Внутренний статус Publication. Не копирует LongTermListing.status
/// и не является статусом провайдера (см. externalStatus).
enum PublicationStatus {
  NOT_PUBLISHED
  PUBLISHING
  PUBLISHED
  UPDATE_PENDING
  UNPUBLISHING
  UNPUBLISHED
  ERROR
}

/// Размещение LongTermListing на одном SalesChannel.
/// Не ChannelListing: ChannelListing остаётся short-term.
model Publication {
  id                String             @id @default(cuid())
  longTermListingId String
  salesChannelId    String
  status            PublicationStatus  @default(NOT_PUBLISHED)
  /// Provider-specific id. NULL до первой успешной публикации.
  externalId        String?
  /// Сырой статус провайдера, без общего enum.
  externalStatus    String?
  lastSyncAt        DateTime?
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  /// SHA-256 of last provider payload used for update detection. NULL until first serialize/prepare.
  lastSerializedHash String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  listing           LongTermListing    @relation(fields: [longTermListingId], references: [id], onDelete: Cascade)
  salesChannel      SalesChannel       @relation(fields: [salesChannelId], references: [id])

  @@unique([longTermListingId, salesChannelId])
  @@index([salesChannelId])
  @@index([status])
}

/// Внутренний статус карточки продажи. Не PublicationStatus и не LongTermListingStatus.
enum SaleListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
  ARCHIVED
}

/// Маркетинговая/бизнес-карточка продажи. Физические факты остаются на Property.
model SaleListing {
  id                String            @id @default(cuid())
  propertyId        String            @unique
  status            SaleListingStatus @default(DRAFT)
  /// Цена продажи, рубли. Не Property.dailyPrice / monthlyPrice / LongTermListing.monthlyPrice.
  price             Int               @default(0)
  marketingTitle    String?
  description       String?
  specialOfferPrice Int?
  specialOfferText  String?
  advantages        String?
  infrastructure    String?
  security          String?
  parking           String?
  transport         String?
  /// Контакт для внешней публикации продажи. Не Buyer, не owner, не LongTermListing contact.
  publicationContactName      String?
  /// Телефонный код страны цифрами, без +. Например 7.
  publicationPhoneCountryCode String?
  /// Национальный номер цифрами, без форматирования площадки.
  publicationPhoneNumber      String?
  /// CRM-only: собственник для контура продажи. Не уходит в публикации/фиды.
  crmOwnerName                String?
  /// CRM-only: телефон собственника для контура продажи.
  crmOwnerPhone               String?
  /// CRM-only: внутренняя заметка. Не Property.description и не marketing description.
  crmComment                  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  property          Property          @relation(fields: [propertyId], references: [id])
  photos            SaleListingPhoto[]
  buyerInterests    BuyerInterest[]
  publications      SalePublication[]

  @@index([status])
}

/// Размещение SaleListing на одном SalesChannel.
/// Не Publication (LongTerm) и не ChannelListing (short-term).
model SalePublication {
  id                 String            @id @default(cuid())
  saleListingId      String
  salesChannelId     String
  status             PublicationStatus @default(NOT_PUBLISHED)
  /// Provider-specific id. NULL до первой успешной публикации провайдером.
  externalId         String?
  /// Сырой статус провайдера, без общего enum.
  externalStatus     String?
  lastAttemptAt      DateTime?
  lastSuccessAt      DateTime?
  lastErrorAt        DateTime?
  lastError          String?
  /// SHA-256 of last normalized/serialized sale payload. NULL until prepare.
  lastSerializedHash String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  listing            SaleListing       @relation(fields: [saleListingId], references: [id], onDelete: Cascade)
  salesChannel       SalesChannel      @relation(fields: [salesChannelId], references: [id])

  @@unique([saleListingId, salesChannelId])
  @@index([salesChannelId])
  @@index([status])
}

/// Привязка существующего PropertyPhoto к SaleListing. Не хранит файлы.
model SaleListingPhoto {
  id              String       @id @default(cuid())
  saleListingId   String
  propertyPhotoId String
  order           Int          @default(0)
  saleListing     SaleListing  @relation(fields: [saleListingId], references: [id], onDelete: Cascade)
  propertyPhoto   PropertyPhoto @relation(fields: [propertyPhotoId], references: [id], onDelete: Cascade)

  @@unique([saleListingId, propertyPhotoId])
  @@index([saleListingId, order])
}

/// Клиент контура продажи. Не Guest (short-term).
model Buyer {
  id               String           @id @default(cuid())
  name             String
  phone            String?
  email            String?
  messengerType    MessengerType?
  messengerContact String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  interests        BuyerInterest[]
  history          BuyerHistory[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

/// Статус интереса покупателя к SaleListing. Не статус Viewing/Deposit.
enum BuyerInterestStatus {
  INTERESTED
  VIEWING_REQUESTED
  VIEWING_SCHEDULED
  VIEWING_COMPLETED
  THINKING
  DEPOSIT_PAID
  PURCHASED
  REFUSED
}

/// N:M связь Buyer ↔ SaleListing. Не хранит saleListingId на Buyer.
model BuyerInterest {
  id            String              @id @default(cuid())
  buyerId       String
  saleListingId String
  status        BuyerInterestStatus @default(INTERESTED)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  buyer         Buyer               @relation(fields: [buyerId], references: [id])
  saleListing   SaleListing         @relation(fields: [saleListingId], references: [id])
  viewings      Viewing[]
  deposits      Deposit[]
  history       BuyerHistory[]

  @@unique([buyerId, saleListingId])
  @@index([buyerId])
  @@index([saleListingId])
  @@index([status])
}

enum ViewingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Показ объекта покупателю. Не влияет на short-term occupancy.
model Viewing {
  id              String        @id @default(cuid())
  buyerInterestId String
  scheduledAt     DateTime
  status          ViewingStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  buyerInterest   BuyerInterest @relation(fields: [buyerInterestId], references: [id])

  @@index([buyerInterestId])
  @@index([status])
  @@index([scheduledAt])
}

enum DepositStatus {
  PENDING
  PAID
  REFUNDED
  FORFEITED
}

/// Задаток по продаже. Не LongTermListing.deposit.
model Deposit {
  id              String        @id @default(cuid())
  buyerInterestId String
  amount          Int
  paidAt          DateTime?
  status          DepositStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  buyerInterest   BuyerInterest @relation(fields: [buyerInterestId], references: [id])

  @@index([buyerInterestId])
  @@index([status])
}

enum BuyerHistoryType {
  BUYER_CREATED
  BUYER_UPDATED
  INTEREST_ADDED
  INTEREST_STATUS_CHANGED
  VIEWING_SCHEDULED
  VIEWING_COMPLETED
  VIEWING_CANCELLED
  VIEWING_NO_SHOW
  DEPOSIT_CREATED
  DEPOSIT_PAID
  DEPOSIT_REFUNDED
  DEPOSIT_FORFEITED
  PURCHASE_COMPLETED
  REFUSED
  NOTE
}

/// Append-only audit timeline for Sales Buyer. No edit/delete.
model BuyerHistory {
  id              String           @id @default(cuid())
  buyerId         String
  buyerInterestId String?
  type            BuyerHistoryType
  message         String?
  createdAt       DateTime         @default(now())
  buyer           Buyer            @relation(fields: [buyerId], references: [id])
  buyerInterest   BuyerInterest?   @relation(fields: [buyerInterestId], references: [id])

  @@index([buyerId, createdAt])
  @@index([buyerInterestId])
  @@index([type])
}

/// Internal CRM user. No roles/RBAC in Stage 11.1.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([isActive])
}

/// Server-side session. DB stores token hash only — never raw cookie token.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  userAgent  String?
  ipHash     String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  OWNER_PAYOUT
  ADJUSTMENT
}

enum FinancialCategory {
  RENT_PAYMENT
  OPERATOR_COMMISSION
  OWNER_SHARE
  CLEANING
  LAUNDRY
  REPAIR
  UTILITIES
  SUPPLIES
  PLATFORM_COMMISSION
  TAX
  ACQUIRING
  ADVERTISING
  OTHER_EXPENSE
  OWNER_PAYOUT
  ADJUSTMENT
  /// Cash returned to guest (EXPENSE). Does not delete the original RENT_PAYMENT income.
  GUEST_REFUND
  /// Long-term tenant security deposit received (INCOME cash, not rent / not commission base).
  SECURITY_DEPOSIT_RECEIVED
  /// Long-term security deposit returned (EXPENSE). Stage 12.3 category reserved; full refund workflow optional.
  SECURITY_DEPOSIT_RETURNED
}

enum FinancialSourceType {
  MANUAL
  BOOKING
  LONG_TERM
  OWNER_SETTLEMENT
  COMMISSION_PAYMENT
  SYSTEM_ADJUSTMENT
}

enum EconomicRole {
  BUSINESS_REVENUE
  PASS_THROUGH
  BUSINESS_EXPENSE
  NEUTRAL
}

enum FinancialCurrency {
  RUB
}

/// CREDIT increases net cash movement; DEBIT decreases. Required for ADJUSTMENT only.
enum AdjustmentDirection {
  CREDIT
  DEBIT
}

/// Who bears an EXPENSE. Null/legacy = OPERATOR (does not reduce owner balance).
enum ExpenseResponsibility {
  OPERATOR
  OWNER
}

/// Structured property owner for COMMISSION settlements. Not used for OWN properties.
model Owner {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  properties Property[]
  payouts   OwnerPayout[]
  settlements OwnerSettlement[]
  financialTransactions FinancialTransaction[]

  @@index([isActive])
  @@index([name])
}

enum OwnerSettlementStatus {
  DRAFT
  CLOSED
}

/// Audit period for owner settlements. Totals are always derived from ledger facts.
model OwnerSettlement {
  id          String                @id @default(cuid())
  ownerId     String
  periodStart DateTime
  periodEnd   DateTime
  status      OwnerSettlementStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime              @default(now())
  closedAt    DateTime?
  owner       Owner                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, periodStart, periodEnd])
  @@index([ownerId, status])
}

/// Cash paid to an external owner (one bank/cash transfer).
model OwnerPayout {
  id        String                 @id @default(cuid())
  ownerId   String
  amount    Int
  paidAt    DateTime
  method    String?
  note      String?
  createdAt DateTime               @default(now())
  owner     Owner                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  allocations OwnerPayoutAllocation[]

  @@index([ownerId, paidAt])
}

model OwnerPayoutAllocation {
  id            String      @id @default(cuid())
  ownerPayoutId String
  propertyId    String
  amount        Int
  createdAt     DateTime    @default(now())
  payout        OwnerPayout @relation(fields: [ownerPayoutId], references: [id], onDelete: Restrict)
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([ownerPayoutId, propertyId])
  @@index([propertyId])
}

/// Cash received from owner for operator commission (COMMISSION properties).
model CommissionPayment {
  id                 String            @id @default(cuid())
  propertyId         String
  bookingId          String?
  longTermContractId String?
  amount             Int
  paidAt             DateTime
  method             String?
  note               String?
  sourceKey          String?           @unique
  createdAt          DateTime          @default(now())
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  booking            Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  longTermContract   LongTermContract? @relation(fields: [longTermContractId], references: [id], onDelete: SetNull)

  @@index([propertyId, paidAt])
  @@index([bookingId])
  @@index([longTermContractId])
}

/// Immutable financial ledger. Amount is always positive integer RUB (major units),
/// matching Booking.totalAmount / Property.dailyPrice conventions — not floating point.
model FinancialTransaction {
  id                  String                    @id @default(cuid())
  propertyId          String?
  bookingId           String?
  longTermListingId   String?
  longTermContractId  String?
  ownerId             String?
  type                FinancialTransactionType
  category            FinancialCategory
  /// Always > 0. Direction comes from type (+ adjustmentDirection for ADJUSTMENT).
  amount              Int
  currency            FinancialCurrency         @default(RUB)
  adjustmentDirection AdjustmentDirection?
  /// For EXPENSE: OPERATOR (default/legacy) or OWNER (reduces owner payable).
  expenseResponsibility ExpenseResponsibility?
  /// Economic classification for unit/business P&L (Stage 12.4).
  economicRole        EconomicRole?
  occurredAt          DateTime
  description         String?
  sourceType          FinancialSourceType
  sourceId            String?
  /// Stable idempotency key, e.g. BOOKING:{id}:RENT. Null for one-off manual entries.
  sourceKey           String?                   @unique
  createdAt           DateTime                  @default(now())
  property            Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  booking             Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  longTermListing     LongTermListing?          @relation(fields: [longTermListingId], references: [id], onDelete: SetNull)
  longTermContract    LongTermContract?         @relation(fields: [longTermContractId], references: [id], onDelete: SetNull)
  owner               Owner?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([propertyId, occurredAt])
  @@index([type, occurredAt])
  @@index([category, occurredAt])
  @@index([sourceType, sourceId])
  @@index([occurredAt])
  @@index([longTermContractId, occurredAt])
  @@index([ownerId, occurredAt])
  @@index([expenseResponsibility, occurredAt])
}

enum LongTermContractStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

/// First calendar month of a contract that does not start on day 1 is not auto-generated.
enum LongTermProrationMode {
  MANUAL_FIRST_PERIOD
}

enum LongTermChargeType {
  RENT
  DEPOSIT
  ADJUSTMENT
}

enum LongTermChargeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// Real long-term lease. Distinct from LongTermListing (marketing).
model LongTermContract {
  id                 String                   @id @default(cuid())
  propertyId         String
  longTermListingId  String?
  guestId            String
  status             LongTermContractStatus   @default(DRAFT)
  startDate          DateTime
  endDate            DateTime?
  /// Snapshot of monthly rent (integer RUB). Not synced from listing after create.
  monthlyRent        Int
  /// Snapshot of security deposit (integer RUB). Not rent; not commission base.
  depositAmount      Int                      @default(0)
  /// Snapshot from Property.commissionMonthly at create/activate. 10000 = 100%.
  commissionRateBps  Int
  /// Day of month rent is due (1–28).
  paymentDay         Int
  prorationMode      LongTermProrationMode    @default(MANUAL_FIRST_PERIOD)
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  property           Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  longTermListing    LongTermListing?         @relation(fields: [longTermListingId], references: [id], onDelete: SetNull)
  guest              Guest                    @relation(fields: [guestId], references: [id], onDelete: Restrict)
  charges            LongTermCharge[]
  payments           LongTermPayment[]
  financialTransactions FinancialTransaction[]
  commissionPayments CommissionPayment[]

  @@index([propertyId, status])
  @@index([guestId])
  @@index([status, startDate])
  @@index([longTermListingId])
}

/// Accrual: what the tenant owes. Not a cash fact.
model LongTermCharge {
  id           String               @id @default(cuid())
  contractId   String
  type         LongTermChargeType
  periodStart  DateTime?
  periodEnd    DateTime?
  dueDate      DateTime
  amount       Int
  currency     FinancialCurrency    @default(RUB)
  status       LongTermChargeStatus @default(OPEN)
  /// e.g. LONG_TERM:{contractId}:RENT:2026-10 or LONG_TERM:{contractId}:DEPOSIT
  sourceKey    String               @unique
  description  String?
  createdAt    DateTime             @default(now())
  contract     LongTermContract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  allocations  LongTermPaymentAllocation[]

  @@index([contractId, dueDate])
  @@index([contractId, status])
  @@index([type, dueDate])
}

/// Cash received from tenant for a long-term contract.
model LongTermPayment {
  id         String                      @id @default(cuid())
  contractId String
  amount     Int
  paidAt     DateTime
  method     String?
  note       String?
  createdAt  DateTime                    @default(now())
  contract   LongTermContract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  allocations LongTermPaymentAllocation[]

  @@index([contractId, paidAt])
}

/// Links a payment to charges it covers.
model LongTermPaymentAllocation {
  id        String         @id @default(cuid())
  paymentId String
  chargeId  String
  amount    Int
  createdAt DateTime       @default(now())
  payment   LongTermPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  charge    LongTermCharge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
}
